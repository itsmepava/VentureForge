# VentureForge local/deployment configuration.
# Copy this file to .env for local development and replace every placeholder.
# Never commit .env or real provider credentials.
NODE_ENV=development
PORT=8080
BASE_PATH=/

DATABASE_URL=postgresql://user:password@localhost:5432/ventureforge
JWT_SECRET=replace-with-a-long-random-secret
FERNET_KEY=replace-with-a-long-random-secret

# Provider and worker configuration
GITHUB_TOKEN=optional-github-app-or-pat
GITHUB_WORKER_ENABLED=false
GITHUB_SCAN_HOUR_UTC=2
GITHUB_WORKER_RUN_ON_STARTUP=false

# Stripe configuration
STRIPE_SECRET_KEY=optional-stripe-secret
STRIPE_WEBHOOK_SECRET=optional-stripe-webhook-secret
STRIPE_SYNC_ENABLED=false
STRIPE_WEBHOOK_BASE_URL=https://ventureforge.example.com

# Optional delivery/model providers
RESEND_API_KEY=optional-resend-api-key
LLM_API_KEY=provided-by-replit-ai-integration
LOG_LEVEL=info